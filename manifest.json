{
  "manifest_version": 3,
  "name": "sideNote",
  "version": "1.0.0",
  "description": "浏览器侧边栏日志笔记：点击图标即开侧栏，支持多文档、置顶、创建/编辑时间记录。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 sideNote 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
